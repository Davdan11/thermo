# ──────────────────────────────────────────────────────────────────────
# ThermopompesÀVendre.ca — variables d'environnement
# Copier vers .env.local (jamais commité). Sans aucune clé, le site tourne :
# les leads sont conservés dans data/leads/*.jsonl et les envois simulés.
# ──────────────────────────────────────────────────────────────────────

# Site public (webhooks Twilio, canonical, sitemaps)
NEXT_PUBLIC_SITE_URL=https://thermopompesavendre.ca

# ── Pipedrive — seul CRM ─────────────────────────────────────────────
# Jeton : Pipedrive → Paramètres → Personnel → API
PIPEDRIVE_API_TOKEN=
# Pipeline des ventes et étape « RDV confirmé » (défauts : 3 et 19)
PIPEDRIVE_PIPELINE_ID=3
PIPEDRIVE_STAGE_RDV_ID=19
# Webhook Pipedrive → /api/webhooks/pipedrive (HTTP Basic). Obligatoire en production.
PIPEDRIVE_WEBHOOK_USER=
PIPEDRIVE_WEBHOOK_PASSWORD=

# ── Courriels (SMTP Google Workspace, ou Resend) ───────────────────────────────────────────────────────────────────
# Relais SMTP Google Workspace (admin : Gmail > Routage > Service de relais SMTP,
# IP du serveur autorisée, TLS exigé) : aucun identifiant nécessaire.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
EMAIL_FROM=info@thermopompesavendre.ca
# Variante avec mot de passe d'application (smtp.gmail.com:465) :
# SMTP_USER=info@thermopompesavendre.ca
# SMTP_PASS=
# Solution de rechange si SMTP absent
RESEND_API_KEY=
# Boîte qui reçoit les alertes de soumission, contact et candidatures
NOTIFICATION_EMAIL=info@thermopompesavendre.ca

# ── Outil de gestion privé (/gestion) ────────────────────────────────
# Adresses qui peuvent se connecter (lien par courriel), séparées par des virgules.
# Vide : NOTIFICATION_EMAIL seulement. Retirer une adresse ferme ses sessions.
ADMIN_EMAILS=
# Clé de signature des sessions (32 caractères ou plus). Vide : clé aléatoire générée
# au premier usage dans le dossier des données (shared/data/gestion-secret.key sur le VPS).
ADMIN_SESSION_SECRET=
# Dossier des fichiers de l'outil (défaut : dossier parent de LEAD_JOURNAL_DIR, donc shared/data).
# GESTION_DATA_DIR=

# ── Journal local des leads (défaut : ./data/leads) ─────────────────
# LEAD_JOURNAL_DIR=/var/lib/thermo/leads

# ── Mesure d'audience (GA4, mode consentement Loi 25) ───────────────
NEXT_PUBLIC_GA_ID=

# ── Twilio — système téléphonique IVR ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+14389003224
TWILIO_FORWARD_VENTES=
TWILIO_FORWARD_SAV=

# ── ElevenLabs — voix de l'IVR (facultatif) ──────────────────────────
ELEVENLABS_API_KEY=

# ── ThermoScan — OCR des plaques signalétiques (Gemini) ─────────────
GEMINI_API_KEY=
THERMOSCAN_MAX_FILE_SIZE_MB=8

# ── Robot de blogue quotidien (scripts/blog-bot.mjs, lancé par scripts/nightly-bot.sh sur le VPS) ──
# Rédaction : clé Anthropic (console.anthropic.com). Modèle par défaut : claude-sonnet-5.
ANTHROPIC_API_KEY=
BLOG_BOT_MODEL=claude-sonnet-5
# Photo de couverture générée : une des deux clés suffit (OpenAI gpt-image-1 ou Google Imagen 4).
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Rendez-vous en ligne (/rendez-vous) : Google Agenda et Google Meet ----
# Compte de service Google Cloud avec délégation au niveau du domaine Workspace (voir DEPLOIEMENT.md).
# Chaque rendez-vous est créé dans l'agenda du conseiller (ou de GOOGLE_CALENDAR_USER) ; les rencontres
# en ligne reçoivent un lien Google Meet envoyé au client. Sans ces variables, le rendez-vous est quand
# même enregistré et l'équipe est prévenue de créer le lien à la main.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=        # clé privée PEM (avec \n) ou encodée en base64
GOOGLE_CALENDAR_USER=info@thermopompesavendre.ca
BOOKINGS_FILE=                     # facultatif : fichier JSON des rendez-vous (défaut : à côté du journal des leads)

# ---- Avis Google et rappels par courriel ----
# Lien « Laisser un avis » de la fiche Google de l'entreprise (Google Business Profile > Demander des avis).
# /avis redirige vers ce lien. Sans lui, aucune demande d'avis n'est planifiée ni envoyée.
GOOGLE_REVIEW_URL=
# Avis Google affichés sur l'accueil et /a-propos (Google Cloud, Places API (New)). Sans les deux, la section ne s'affiche pas.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Adresse postale de l'entreprise, obligatoire (LCAP) dans les rappels et demandes d'avis.
# Sans elle, rien ne part : les messages restent en file et le robot l'indique dans son journal.
BUSINESS_MAILING_ADDRESS=
# Facultatif : fichier de la file des rappels (défaut : à côté du journal des leads, shared/data/relances.json sur le VPS)
# RELANCES_FILE=

# ── Assistant de questions (Claude) ─────────────────────────────────
# Sans clé Anthropic, le bouton « Une question ? » n'est pas affiché.
# La présence du bouton est décidée au build : redéployer après l'ajout de la clé.
ANTHROPIC_API_KEY=
# Modèle (défaut : claude-sonnet-5)
# ASSISTANT_MODEL=
# Plafond de réponses par jour, tous visiteurs confondus (défaut : 800)
# ASSISTANT_DAILY_LIMIT=
# Couper l'assistant : 1
# ASSISTANT_DISABLED=
# Utiliser Gemini à la place (partage le quota de ThermoScan, donc déconseillé) : 1
# ASSISTANT_GEMINI=
# ASSISTANT_GEMINI_MODEL=
