# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

Thermomatchengine/node_modules/
test-*.mjs

# brochures PDF des fabricants (217 Mo, hors dépôt ; les images extraites sont dans public/images/products/brochures)
/public/documents/brochures

# journal local des leads (renseignements personnels, jamais dans le dépôt)
/data/leads

# Candidats de logos avant validation (voir scripts/finalize-brand-logos.mjs)
public/images/marques/_candidats/

# Originaux des photos officielles (156 Mo) : seule la provenance SOURCES.json est versionnée
public/images/products/_official-sources/**
!public/images/products/_official-sources/*/
!public/images/products/_official-sources/*/SOURCES.json

# réservations de rendez-vous (données locales ; shared/data sur le VPS)
/data/rendez-vous.json

# abonnés aux alertes LogisVert (courriels ; shared/data sur le VPS, jamais dans le dépôt)
/data/alertes-logisvert.json
/data/alertes-logisvert.json.lock

# file des relances et demandes d'avis (courriels ; shared/data sur le VPS, jamais dans le dépôt)
/data/relances.json
/data/relances.json.lock

# outil de gestion privé : installateurs, jobs, candidatures, liens de connexion et clé des sessions
# (shared/data sur le VPS, jamais dans le dépôt)
/data/gestion*.json
/data/gestion*.json.lock
/data/gestion*.tmp
/data/gestion-secret.key

# surveillance du site : état et historique des vérifications (shared/data sur le VPS)
/data/surveillance*.json
/data/surveillance*.jsonl
/data/surveillance*.tmp

# créateur de soumissions : soumissions, acceptations, réglages, consultations et photos des clients
# (shared/data sur le VPS, jamais dans le dépôt)
/data/soumissions*.json
/data/soumissions*.json.lock
/data/soumissions*.tmp
/data/soumissions-vues.jsonl
/data/soumissions-photos/

# textos reçus au numéro du site (numéros et messages des clients ; shared/data sur le VPS)
/data/textos.json
/data/textos.json.lock

# sécurité de /gestion (chantier S) : journal d'audit, fichier .env d'essai, état des sauvegardes
/data/gestion-journal/
/data/gestion-env-essai/
/data/sauvegardes-etat.json
