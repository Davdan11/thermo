# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

Thermomatchengine/node_modules/
test-*.mjs

# brochures PDF des fabricants (217 Mo, hors dépôt ; les images extraites sont dans public/images/products/brochures)
/public/documents/brochures

# journal local des leads (renseignements personnels, jamais dans le dépôt)
/data/leads

# Candidats de logos avant validation (voir scripts/finalize-brand-logos.mjs)
public/images/marques/_candidats/

# Originaux des photos officielles (156 Mo) : seule la provenance SOURCES.json est versionnée
public/images/products/_official-sources/**
!public/images/products/_official-sources/*/
!public/images/products/_official-sources/*/SOURCES.json

# réservations de rendez-vous (données locales ; shared/data sur le VPS)
/data/rendez-vous.json

# abonnés aux alertes LogisVert (courriels ; shared/data sur le VPS, jamais dans le dépôt)
/data/alertes-logisvert.json
/data/alertes-logisvert.json.lock
